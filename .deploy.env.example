# Configuration for ./scripts/deploy.sh — copy to .deploy.env (gitignored)
# and fill in. Real values for this project live in DEPLOY.local.md.
#
# scripts/deploy.sh sources this file with `set -a`, so every key in here
# becomes an exported env var visible to rsync/ssh. Only DEPLOY_* keys are
# read by the script — but other keys (PATH, SSH_AUTH_SOCK, etc.) added
# here will leak into the subprocess environment. Keep it minimal.

# SSH host or IP of the running Home Assistant instance.
DEPLOY_HOST=ha.example.lan

# SSH user on that host.
DEPLOY_USER=your-ha-user

# Optional — defaults to /homeassistant/custom_components/abode_security
# (standard HA-OS layout). Override for non-standard installs, e.g. a
# supervisor-less HA Core under a different config root:
#DEPLOY_PATH=/usr/share/hassio/homeassistant/custom_components/abode_security
