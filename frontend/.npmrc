# npm configuration for the frontend panel. The quiet-output settings below
# are aimed at CI; `engine-strict` deliberately applies locally too.
audit=false
fund=false
loglevel=error
# The @web/* 1.x test-runner line requires Node >=22 and errorstacks requires
# >=24, while .nvmrc drives every CI job's Node version. Without this, a
# too-old Node only produces an EBADENGINE warning and the run continues on an
# unsupported runtime. Fail the install instead.
engine-strict=true
