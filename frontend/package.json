{
  "name": "abode-security-frontend",
  "version": "1.0.0",
  "description": "Frontend panel for Abode Security Home Assistant integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "rollup -c -w --environment BUILD:development",
    "test": "web-test-runner --node-resolve",
    "test:watch": "web-test-runner --node-resolve --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --check \"src/**/*.ts\" \"*.{js,mjs,json}\"",
    "format:write": "prettier --write \"src/**/*.ts\" \"*.{js,mjs,json}\""
  },
  "keywords": [
    "home-assistant",
    "abode",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.1",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-lit": "^2.3.1",
    "prettier": "^3.9.5",
    "rollup": "^4.60.4",
    "sinon": "^22.0.0",
    "tslib": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
