{
  "name": "abode-security-frontend",
  "version": "1.0.0",
  "description": "Frontend panel for Abode Security Home Assistant integration",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "rollup -c -w --environment BUILD:development",
    "test": "web-test-runner --node-resolve",
    "test:watch": "web-test-runner --node-resolve --watch"
  },
  "keywords": [
    "home-assistant",
    "abode",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/sinon": "^21.0.0",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.18.0",
    "@web/test-runner-playwright": "^0.11.0",
    "rollup": "^4.22.0",
    "sinon": "^21.0.1",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2"
  }
}
