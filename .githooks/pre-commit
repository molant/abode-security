#!/bin/bash
set -e

echo "Running pre-commit checks..."

# Auto-discard changes to HA dev config auth file (accumulates session tokens)
if git diff --name-only --cached | grep -q "config/.storage/auth"; then
    echo "Removing config/.storage/auth from commit (dev environment file)..."
    git reset HEAD -- config/.storage/auth >/dev/null 2>&1 || true
    git checkout -- config/.storage/auth >/dev/null 2>&1 || true
fi

# Set PYTHONPATH to include vendored libraries and integration
export PYTHONPATH="$(cd "$(dirname "$0")/../custom_components" && pwd):$PYTHONPATH"

# Lint with ruff. All tools run via `uv run` so the hook, scripts/check.sh,
# and CI share a single dependency source (pyproject.toml [project.optional-
# dependencies].dev resolved via uv.lock). Previously the hook used
# `python3 -m`, which resolved against the user's system site-packages and
# could drift from .venv whenever pyproject.toml changed.
echo "Linting with ruff..."
uv run ruff check custom_components/abode_security tests
uv run ruff format --check custom_components/abode_security tests

# Type check with mypy
echo "Type checking with mypy..."
uv run mypy custom_components/abode_security --ignore-missing-imports

# Strict type check with pyright (catches cached_property / variable-override
# issues mypy is permissive about; see scripts/check.sh for full rationale).
echo "Type checking with pyright..."
uv run pyright custom_components/abode_security

# Run tests with pytest
echo "Running tests with pytest..."
uv run pytest tests/ -v --tb=short

# Frontend gates — only run when frontend files are staged
if git diff --name-only --cached | grep -q '^frontend/'; then
    echo "Frontend changes detected — running frontend gates..."
    (cd frontend && npm run lint && npm run format && npm run typecheck && npm test)
fi

echo "Pre-commit checks passed!"
